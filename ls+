#!/bin/sh

config_file="$HOME/.ls+config"

if [ "$1" = "--set" ]; then
    shift
    case "$1" in
        help)
            echo "Uso: ls+ --set <opzione> <valore>"
            echo ""
            echo "Opzioni:"
            echo "  color true|false    - Colori (verde=eseguibili, blu=directory)"
            echo "  order default       - Ordinamento predefinito"
            echo "  order folders       - Prima cartelle, poi file in ordine alfabetico"
            echo "  order type          - Ordina per estensione (cartelle prima)"
            echo "  order size          - Ordina per dimensione (piu grandi prima)"
            exit 0
            ;;
        color|order)
            key="$1"; shift; val="$1"; shift
            tmp="${config_file}.tmp"
            if [ -f "$config_file" ]; then
                grep -v "^${key}=" "$config_file" > "$tmp" 2>/dev/null || true
            else
                : > "$tmp"
            fi
            echo "${key}=${val}" >> "$tmp"
            mv "$tmp" "$config_file"
            exit 0
            ;;
        *)
            echo "Opzione sconosciuta: $1" >&2
            echo "Usa: ls+ --set help" >&2
            exit 1
            ;;
    esac
fi

color_mode=0
sort_order="default"
if [ -f "$config_file" ]; then
    while IFS='=' read -r key val; do
        case "$key" in
            color) [ "$val" = "true" ] && color_mode=1 ;;
            order)
                case "$val" in
                    default|folders|type|size) sort_order="$val" ;;
                esac
                ;;
        esac
    done < "$config_file"
fi

w=$(stty size < /dev/tty 2>/dev/null | cut -d' ' -f2)
w=${w:-${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}}

tmp_e=$(mktemp 2>/dev/null || echo "/tmp/lsplus_e_$$")
trap 'rm -f "$tmp_e"' EXIT INT TERM

ls_cmd="ls -F"
if [ "$1" = "-a" ]; then
    shift
    ls_cmd="ls -aF"
fi
if [ "$color_mode" -eq 1 ]; then
    ls_cmd="${ls_cmd} --color=always"
fi

new_args=""
for a in "$@"; do
    if [ -d "$a" ]; then
        case "$a" in */) new_args="$new_args $a" ;; *) new_args="$new_args ${a}/" ;; esac
    else
        new_args="$new_args $a"
    fi
done
set -- $new_args

awk_prog='
function vl(s, n,i,c,ch) {
    n = length(s); c = 0
    for (i = 1; i <= n; ) {
        ch = substr(s, i, 1)
        if (index("\340\341\342\343\344\345\346\347\350\351\352\353\354\355\356\357", ch)) i += 3
        else if (index("\300\301\302\303\304\305\306\307\310\311\312\313\314\315\316\317\320\321\322\323\324\325\326\327\330\331\332\333\334\335\336\337", ch)) i += 2
        else if (index("\360\361\362\363\364\365\366\367", ch)) i += 4
        else i++
        c++
    }
    return c
}
function pad(s,w, v) {
    v = vl(s)
    while (v < w) { s = s " "; v++ }
    return s
}
function center(s,w, v,l,r) {
    v = vl(s)
    if (v >= w) return s
    l = int((w - v) / 2); r = w - v - l
    while (l-- > 0) s = " " s
    while (r-- > 0) s = s " "
    return s
}
BEGIN {
    FS = "\t"
    bw = 15; tw = 11; lt = 30; n = 0
    folder[1] = "    \342\225\224\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\256    "
    folder[2] = "    \342\225\221\342\226\210\342\226\222\342\226\222\342\226\222\342\226\210\342\225\221"
    folder[3] = "    \342\225\221\342\226\210\342\226\210\342\226\210\342\226\210\342\226\210\342\225\221"
    folder[4] = "    \342\225\232\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\235"
    file[1]  = "     \342\226\221\342\226\221\342\226\221\342\226\221\342\227\243"
    file[2]  = "     \342\226\221\342\226\221\342\226\221\342\226\221\342\226\221"
    file[3]  = "     \342\226\221\342\226\221\342\226\221\342\226\221\342\226\221"
    if (color_mode) {
        RESET = "\033[0m"
    }
}
{
    type = $1; name = $4; n++
    ty[n] = type; col[n] = $5
    if (type == "D") {
        al = 4
        for (i = 1; i <= al; i++)
            blk[n,i] = pad(folder[i], bw)
        tl = 0; t = name
        while (vl(t) > tw) {
            tl++; bp = 0; k = 0
            while (k < tw - 1 && bp < length(t)) {
                bp++; k++
                ch = substr(t, bp, 1)
                if (index("\340\341\342\343\344\345\346\347\350\351\352\353\354\355\356\357", ch)) bp += 2
                else if (index("\300\301\302\303\304\305\306\307\310\311\312\313\314\315\316\317\320\321\322\323\324\325\326\327\330\331\332\333\334\335\336\337", ch)) bp += 1
                else if (index("\360\361\362\363\364\365\366\367", ch)) bp += 3
            }
            if (substr(t, bp + 1, 1) == " ") {
                blk[n, al + tl] = center(substr(t, 1, bp), bw)
                t = substr(t, bp + 2)
            } else if (substr(t, bp, 1) == " ") {
                blk[n, al + tl] = center(substr(t, 1, bp - 1), bw)
                t = substr(t, bp + 1)
            } else {
                blk[n, al + tl] = center(substr(t, 1, bp) "-", bw)
                t = substr(t, bp + 1)
            }
        }
        if (vl(t) > 0) {
            tl++
            blk[n, al + tl] = center(t, bw)
        }
        nh[n] = al + tl
    } else if (vl(name) > lt) {
        ln = 0
        blk[n, ++ln] = pad(" \342\226\221\342\226\221\342\226\221\342\226\221\342\226\221\342\226\221\342\226\221\342\226\221\342\226\221\342\226\221\342\226\221\342\226\221\342\227\243 ", bw)
        cw = bw - 3; t = name
        while (vl(t) >= cw) {
            bp = 0; k = 0
            while (k < cw - 2 && bp < length(t)) {
                bp++; k++
                ch = substr(t, bp, 1)
                if (index("\340\341\342\343\344\345\346\347\350\351\352\353\354\355\356\357", ch)) bp += 2
                else if (index("\300\301\302\303\304\305\306\307\310\311\312\313\314\315\316\317\320\321\322\323\324\325\326\327\330\331\332\333\334\335\336\337", ch)) bp += 1
                else if (index("\360\361\362\363\364\365\366\367", ch)) bp += 3
            }
            if (substr(t, bp + 1, 1) == " ") {
                blk[n, ++ln] = pad(" \342\226\221" substr(t, 1, bp) " \342\226\221", bw)
                t = substr(t, bp + 2)
            } else if (substr(t, bp, 1) == " ") {
                blk[n, ++ln] = pad(" \342\226\221" pad(substr(t, 1, bp - 1), cw - 1) "\342\226\221", bw)
                t = substr(t, bp + 1)
            } else {
                blk[n, ++ln] = pad(" \342\226\221" substr(t, 1, bp) "-\342\226\221", bw)
                t = substr(t, bp + 1)
            }
        }
        if (vl(t) > 0)
            blk[n, ++ln] = pad(" \342\226\221" pad(t, cw - 1) "\342\226\221", bw)
        blk[n, ++ln] = pad(" \342\226\221\342\226\221\342\226\221\342\226\221\342\226\221\342\226\221\342\226\221\342\226\221\342\226\221\342\226\221\342\226\221\342\226\221\342\226\221 ", bw)
        nh[n] = ln
    } else {
        al = 3
        for (i = 1; i <= al; i++)
            blk[n,i] = pad(file[i], bw)
        tl = 0; t = name
        while (vl(t) > tw) {
            tl++; bp = 0; k = 0
            while (k < tw - 1 && bp < length(t)) {
                bp++; k++
                ch = substr(t, bp, 1)
                if (index("\340\341\342\343\344\345\346\347\350\351\352\353\354\355\356\357", ch)) bp += 2
                else if (index("\300\301\302\303\304\305\306\307\310\311\312\313\314\315\316\317\320\321\322\323\324\325\326\327\330\331\332\333\334\335\336\337", ch)) bp += 1
                else if (index("\360\361\362\363\364\365\366\367", ch)) bp += 3
            }
            if (substr(t, bp + 1, 1) == " ") {
                blk[n, al + tl] = center(substr(t, 1, bp), bw)
                t = substr(t, bp + 2)
            } else if (substr(t, bp, 1) == " ") {
                blk[n, al + tl] = center(substr(t, 1, bp - 1), bw)
                t = substr(t, bp + 1)
            } else {
                blk[n, al + tl] = center(substr(t, 1, bp) "-", bw)
                t = substr(t, bp + 1)
            }
        }
        if (vl(t) > 0) {
            tl++
            blk[n, al + tl] = center(t, bw)
        }
        nh[n] = al + tl
    }
}
END {
    if (n == 0) exit
    cw = bw + 1
    nc = int(w / cw)
    if (nc < 1) nc = 1
    for (r = 1; r <= n; r += nc) {
        rh = 0
        for (c = 0; c < nc && (r + c) <= n; c++)
            if (nh[r + c] > rh) rh = nh[r + c]
        for (ln = 1; ln <= rh; ln++) {
            line = ""
            for (c = 0; c < nc && (r + c) <= n; c++) {
                s = blk[r + c, ln]
                if (s == "") s = pad("", bw)
                if (color_mode && col[r + c] != "") {
                    s = col[r + c] s RESET
                }
                line = line s
                if (c < nc - 1 && (r + c) < n) line = line " "
            }
            sub(/ +$/, "", line)
            print line
        }
    }
}'

flush_entries() {
    if [ -s "$tmp_e" ]; then
        if [ "$sort_order" = "folders" ]; then
            sort -t"$(printf '\t')" -k1,1 -k4,4 "$tmp_e"
        elif [ "$sort_order" = "type" ]; then
            sort -t"$(printf '\t')" -k1,1 -k2,2 -k4,4 "$tmp_e"
        elif [ "$sort_order" = "size" ]; then
            sort -t"$(printf '\t')" -k3 -rn "$tmp_e"
        else
            cat "$tmp_e"
        fi | awk -v w="$w" -v color_mode="$color_mode" "$awk_prog"
        : > "$tmp_e"
    fi
}

$ls_cmd "$@" | {
    first=1
    esc=$(printf '\033')
    while IFS= read -r e; do
        t=F
        ansi_prefix=""
        if [ "$color_mode" -eq 1 ]; then
            ansi_prefix=$(printf '%s\n' "$e" | sed -n "s/^\(${esc}\[[0-9;]*m\).*/\1/p")
            e=$(printf '%s\n' "$e" | sed "s/${esc}\[[0-9;]*m//g")
        fi
        name="$e"
        case "$e" in
            *:) n="${e%:}"
                if [ -d "$n" ]; then
                    flush_entries
                    if [ "$first" -eq 0 ]; then
                        printf '\n'
                    fi
                    first=0
                    if [ "$color_mode" -eq 1 ]; then
                        printf '\033[1;37m\342\225\220\342\225\220\342\225\220 %s \342\225\220\342\225\220\342\225\220\033[0m\n' "$n"
                    else
                        printf '=== %s ===\n' "$n"
                    fi
                    continue
                fi
                ;;
        esac
        [ "$first" -eq 1 ] && first=0
        case "$e" in
            */) t=D; name="${e%/}" ;;
            *\*) name="${e%\*}"
                if [ "$color_mode" -eq 1 ] || [ -x "$name" ]; then t=E; fi ;;
            *@) name="${e%@}"
                [ -d "$name" ] && t=D ;;
            *\|) name="${e%|}" ;;
            *\>) name="${e%>}" ;;
            *=) name="${e%=}" ;;
        esac
        ext=""
        case "$name" in *.*) ext="${name##*.}" ;; esac
        size=0
        [ "$sort_order" = "size" ] && size=$(stat -c '%s' "$name" 2>/dev/null || echo 0)
        printf '%s\t%s\t%s\t%s\t%s\n' "$t" "$ext" "$size" "$name" "$ansi_prefix" >> "$tmp_e"
    done
    flush_entries
}
